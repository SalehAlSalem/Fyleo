/**
 * PostCard Component
 * Displays a post with text content and optional link
 * Matches MaterialCard design
 */

import React from 'react';
import { motion } from 'framer-motion';
import type { Post } from '../../../types/database';

interface PostCardProps {
  post: Post;
  onView?: () => void;
  className?: string;
  labels: {
    link: string;
    viewPost: string;
  };
}

/**
 * Format date in Gregorian calendar
 */
const formatDate = (dateString: string): string => {
  const date = new Date(dateString);
  // Always use Gregorian calendar (en-US locale)
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};

const PostCard: React.FC<PostCardProps> = ({
  post,
  onView,
  className = '',
  labels,
}) => {
  const hasLink = post.linkURL && post.linkURL.trim() !== '';
  const hasText = post.contentText && post.contentText.trim() !== '';
  const isArabic = document.documentElement.dir === 'rtl';

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.9, y: 30 }}
      animate={{ opacity: 1, scale: 1, y: 0 }}
      whileHover={{ 
        y: -12, 
        scale: 1.03,
        rotateY: 2,
        rotateX: -2,
        transition: { type: "spring", stiffness: 300, damping: 20 }
      }}
      whileTap={{ scale: 0.97 }}
      transition={{ duration: 0.4, type: "spring" }}
      className={`group relative bg-white dark:bg-[#1a2332] rounded-2xl overflow-hidden shadow-2xl hover:shadow-[0_25px_80px_rgba(0,0,0,0.35)] border border-gray-200 dark:border-gray-700/50 hover:border-green-400 dark:hover:border-green-500 ${className}`}
      style={{ transformStyle: 'preserve-3d' }}
    >
      {/* Animated Glow Background */}
      <div className="absolute -inset-2 bg-gradient-to-r from-green-500/0 via-teal-500/0 to-blue-500/0 group-hover:from-green-500/20 group-hover:via-teal-500/20 group-hover:to-blue-500/20 rounded-3xl blur-2xl transition-all duration-700 pointer-events-none"></div>
      
      {/* Floating Particles */}
      <motion.div
        className="absolute top-6 right-6 w-3 h-3 bg-green-400/50 rounded-full blur-sm"
        animate={{
          y: [0, -15, 0],
          opacity: [0.3, 0.8, 0.3],
          scale: [1, 1.3, 1]
        }}
        transition={{
          duration: 3.5,
          repeat: Infinity,
          ease: "easeInOut"
        }}
      />
      <motion.div
        className="absolute bottom-8 left-8 w-2 h-2 bg-teal-400/50 rounded-full blur-sm"
        animate={{
          y: [0, -20, 0],
          opacity: [0.4, 0.9, 0.4]
        }}
        transition={{
          duration: 4,
          repeat: Infinity,
          ease: "easeInOut",
          delay: 0.7
        }}
      />
      {/* Header with gradient */}
      <div className="relative bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 p-4 border-b border-gray-300 dark:border-gray-700/50 group-hover:border-green-300 dark:group-hover:border-green-600 transition-colors duration-500" style={{ height: '177px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
        {/* Gradient Glow Overlay */}
        <div className="absolute inset-0 bg-gradient-to-br from-green-400/0 via-teal-400/0 to-blue-400/0 group-hover:from-green-400/10 group-hover:via-teal-400/10 group-hover:to-blue-400/10 transition-all duration-700 pointer-events-none"></div>
        
        {/* Link Icon with Glow */}
        <div className="relative">
          <div className="absolute inset-0 bg-gradient-to-br from-green-400/40 to-teal-400/40 rounded-xl blur-2xl group-hover:blur-3xl group-hover:from-green-400/60 group-hover:to-teal-400/60 transition-all duration-500 scale-150"></div>
          <motion.div 
            className="relative w-20 h-20 rounded-xl bg-gray-200/50 dark:bg-white/10 backdrop-blur-sm flex items-center justify-center text-5xl border border-gray-300 dark:border-white/20 shadow-lg"
            whileHover={{
              scale: 1.15,
              rotate: [0, -10, 10, -10, 0],
              y: -4
            }}
            transition={{
              type: "spring",
              stiffness: 400,
              damping: 10
            }}
          >
            🔗
          </motion.div>
        </div>
      </div>

      {/* Content */}
      <div className="relative p-4 group-hover:translate-y-[-2px] transition-transform duration-300">
        {/* Text Content */}
        {hasText && (
          <motion.div 
            className="mb-4"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.2 }}
          >
            <p className="text-gray-900 dark:text-white text-sm leading-relaxed line-clamp-4 text-right">
              {post.contentText}
            </p>
          </motion.div>
        )}

        {/* Link Info */}
        {hasLink && (
          <motion.div 
            className="bg-gradient-to-br from-gray-100 to-gray-50 dark:from-gray-800/50 dark:to-gray-700/30 rounded-lg p-3 mb-4 border border-gray-200 dark:border-gray-700 group-hover:border-green-300 dark:group-hover:border-green-600 transition-colors duration-300"
            whileHover={{ scale: 1.02 }}
          >
            <div className="text-gray-600 dark:text-gray-400 text-xs mb-2 text-right">
              {isArabic ? 'الرابط' : 'Link'}
            </div>
            <div className="text-blue-600 dark:text-blue-400 text-sm font-medium truncate text-right" dir="ltr">
              {post.linkURL}
            </div>
          </motion.div>
        )}

        {/* Uploader Info */}
        <motion.div 
          className="bg-gradient-to-br from-gray-100 to-gray-50 dark:from-gray-800/30 dark:to-gray-700/20 rounded-lg p-3 mb-4 border border-gray-200 dark:border-gray-700"
          whileHover={{ scale: 1.02 }}
        >
          <div className="flex items-center gap-3">
            <motion.div 
              className="w-12 h-12 rounded-full bg-gradient-to-br from-green-500 to-teal-500 flex items-center justify-center text-white font-bold text-lg shadow-lg"
              whileHover={{ scale: 1.1, rotate: [0, -5, 5, 0] }}
              transition={{ type: "spring", stiffness: 400 }}
            >
              {((post as any).uploaderName || 
                (post as any).uploader?.name || 
                'Unknown User')[0].toUpperCase()}
            </motion.div>
            <div className="flex-1">
              <p className="text-gray-900 dark:text-white text-sm font-bold">
                {(post as any).uploaderName || 
                 (post as any).uploader?.name || 
                 'Unknown User'}
              </p>
              <p className="text-gray-600 dark:text-gray-400 text-xs">
                {formatDate(post.$createdAt)}
              </p>
            </div>
          </div>
        </motion.div>

        {/* Action Button */}
        {hasLink && (
          <motion.a
            href={post.linkURL}
            target="_blank"
            rel="noopener noreferrer"
            className="relative block w-full px-3 py-2.5 rounded-xl bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 text-white font-bold text-sm text-center transition-all shadow-lg hover:shadow-2xl overflow-hidden"
            whileHover={{ scale: 1.05, y: -2 }}
            whileTap={{ scale: 0.98 }}
          >
            {/* Shimmer Effect */}
            <motion.div
              className="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent"
              animate={{ x: ['-100%', '200%'] }}
              transition={{ duration: 2, repeat: Infinity, ease: "linear", repeatDelay: 1 }}
            />
            <span className="relative flex items-center justify-center gap-2 z-10">
              <span>🔗</span>
              <span>{isArabic ? 'فتح الرابط' : 'Open Link'}</span>
            </span>
          </motion.a>
        )}

        {/* View Post Button (if no link) */}
        {!hasLink && onView && (
          <motion.button
            onClick={onView}
            className="relative w-full px-3 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-bold text-sm text-center transition-all shadow-lg hover:shadow-2xl flex items-center justify-center gap-2 overflow-hidden"
            whileHover={{ scale: 1.05, y: -2 }}
            whileTap={{ scale: 0.98 }}
          >
            {/* Shimmer Effect */}
            <motion.div
              className="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent"
              animate={{ x: ['-100%', '200%'] }}
              transition={{ duration: 2, repeat: Infinity, ease: "linear", repeatDelay: 1 }}
            />
            <span className="relative z-10">👁️</span>
            <span className="relative z-10">{labels.viewPost}</span>
          </motion.button>
        )}
      </div>

      {/* Bottom accent line */}
      <motion.div 
        className="relative h-1 bg-gradient-to-r from-green-600 via-teal-600 to-blue-600 overflow-hidden"
      >
        {/* Shimmer Effect */}
        <motion.div
          className="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent"
          animate={{ x: ['-100%', '200%'] }}
          transition={{ duration: 2, repeat: Infinity, ease: "linear", repeatDelay: 1 }}
        />
      </motion.div>
    </motion.div>
  );
};

export default PostCard;

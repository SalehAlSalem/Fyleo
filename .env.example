# 🔥 Firebase Configuration (Required for Auth & Database ONLY)
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id_here"
VITE_FIREBASE_APP_ID="your_app_id_here"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id_here"

# 🚀 Hybrid Storage Configuration (Required for File Upload)

# GitHub Storage (Free for files < 25MB)
VITE_GITHUB_OWNER="SalehAlSalem"
VITE_GITHUB_REPO="Fyleo"
VITE_GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# Supabase Storage (1GB Free/month for files 25-100MB)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.your_supabase_anon_key_here"

# App Configuration
VITE_APP_NAME="Fyleo"
VITE_APP_VERSION="2.0.0"
VITE_APP_DESCRIPTION="جامعة البلقاء التطبيقية - منصة مشاركة الملفات التعليمية"

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_RTL=true
VITE_AUTO_APPROVE="true"

# File Upload Settings (Hybrid Storage Limits)
VITE_MAX_FILE_SIZE=104857600  # 100MB in bytes
VITE_ALLOWED_FILE_TYPES="pdf,doc,docx,ppt,pptx,xls,xlsx,txt,jpg,jpeg,png,gif,webp,mp4,mov,avi"
VITE_GITHUB_SIZE_LIMIT=26214400  # 25MB limit for GitHub
VITE_SUPABASE_SIZE_LIMIT=104857600  # 100MB limit for Supabase

# 📋 Setup Instructions:
# 1. Replace Firebase credentials with your actual project values
# 2. Create GitHub Personal Access Token with 'repo' permissions at: https://github.com/settings/tokens
# 3. Create Supabase project at: https://app.supabase.com/projects
# 4. Copy this file to '.env' and update with real values
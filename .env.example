# ملف البيئة - PocketBase Configuration
# انسخ هذا الملف إلى .env واملأ القيم

# PocketBase Server URL
# استبدل هذا برابط السيرفر الخاص بك
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# PocketBase Admin Credentials (للتطوير فقط)
POCKETBASE_ADMIN_EMAIL=admin@fyleo.com
POCKETBASE_ADMIN_PASSWORD=your_secure_password

# Application Settings
NEXT_PUBLIC_APP_NAME=Fyleo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Settings
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,png,webp

# Feature Flags
NEXT_PUBLIC_ENABLE_DISCUSSIONS=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_MATERIALS_UPLOAD=true

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_ANALYTICS_ID=

# ============================================================================
# 🔒 Fyleo - Git Ignore Configuration
# ============================================================================
# This file prevents sensitive and unnecessary files from being pushed to GitHub
# Created: October 15, 2025
# ============================================================================

# ============================================================================
# 🔐 CRITICAL SECURITY FILES - NEVER COMMIT THESE!
# ============================================================================

# Environment variables (contains API keys, secrets, passwords)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Firebase configuration (if contains sensitive data)
firebase-config.js
firebaseConfig.js

# API Keys and Secrets
secrets.json
credentials.json
service-account.json
*.pem
*.key
*.cert

# ============================================================================
# 📦 Dependencies & Build Files
# ============================================================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
.next/
out/

# ============================================================================
# 🛠️ Development & IDE Files
# ============================================================================

# VS Code
.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# 🧪 Testing & Coverage
# ============================================================================

# Test coverage
coverage/
*.lcov
.nyc_output/

# Jest
jest-coverage/

# ============================================================================
# 📝 Logs & Temporary Files
# ============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
*.tmp
*.temp
.cache/

# ============================================================================
# 🖥️ Operating System Files
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================================
# 🎨 Editor & IDE Specific
# ============================================================================

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ============================================================================
# 📱 Mobile & Native
# ============================================================================

# React Native
.expo/
.expo-shared/

# ============================================================================

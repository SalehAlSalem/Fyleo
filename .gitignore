.yarn/install-state.gz
.pnp.*

# npm
package-lock.json
npm-shrinkwrap.json

# pnpm
pnpm-lock.yaml

# ============================================================================
# 🗄️ Database Files (if local)
# ============================================================================

# SQLite
*.sqlite
*.sqlite3
*.db

# MongoDB
*.mongodb

# ============================================================================
# 📊 Analytics & Monitoring
# ============================================================================

# Sentry
.sentryclirc

# ============================================================================
# 🚀 Deployment & CI/CD
# ============================================================================

# Vercel
.vercel

# Netlify
.netlify

# ============================================================================
# 📄 Documentation & Reports (Optional)
# ============================================================================

# Generated documentation (if you want to exclude)
# docs/generated/

# Reports
reports/
*.report.html
*.report.json

# ============================================================================
# 🎯 Project Specific
# ============================================================================

# Backup files
*.backup
*.bak
*.old

# Archive files (if temporary)
*.zip
*.tar.gz
*.rar

# Large media files (if not needed in repo)
# *.mp4
# *.mov
# *.avi

# ============================================================================
# ✅ IMPORTANT NOTES
# ============================================================================
# 
# 1. The .env file is CRITICAL - it contains:
#    - Appwrite API keys
#    - Database credentials
#    - Storage keys
#    - Any other sensitive configuration
#
# 2. Always use environment variables for:
#    - API keys
#    - Database URLs
#    - Secret tokens
#    - Passwords
#
# 3. For deployment, set environment variables in your hosting platform:
#    - Vercel: Project Settings → Environment Variables
#    - Netlify: Site Settings → Build & Deploy → Environment
#    - GitHub Pages: Repository Settings → Secrets
#
# 4. Share .env.example (without actual values) for team reference
#
# ============================================================================
